+/* Rewrites the decoded create info in place. Returns the copy to free after the driver call. */
+static uint32_t *
+vkr_flatten_shader_module_info(struct vkr_device *dev, const VkShaderModuleCreateInfo *info)
+{
+   uint32_t *code;
+   size_t size;
+   if (!dev->physical_device->flatten_spirv ||
+       !vkr_spirv_flatten(info->pCode, info->codeSize, &code, &size))
+      return NULL;
+   VkShaderModuleCreateInfo *writable = (VkShaderModuleCreateInfo *)info;
+   writable->pCode = code;
+   writable->codeSize = size;
+   return code;
+}
+
+struct vkr_flattened_codes {
+   uint32_t **codes;
+   uint32_t count;
+};
+
+/* for shader code passed inline in a stage's pNext, without a VkShaderModule */
+static void
+vkr_flatten_pipeline_stages(struct vkr_device *dev,
+                            const VkPipelineShaderStageCreateInfo *stages,
+                            uint32_t stage_count,
+                            struct vkr_flattened_codes *flattened)
+{
+   /* null for a pipeline library without shader stages, whatever stageCount says */
+   if (!dev->physical_device->flatten_spirv || !stages)
+      return;
+   for (uint32_t i = 0; i < stage_count; i++) {
+      for (const VkBaseInStructure *p = stages[i].pNext; p; p = p->pNext) {
+         if (p->sType != VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO)
+            continue;
+         /* room for the copy first: once rewritten, the create info points at it */
+         uint32_t **codes = realloc(flattened->codes, (flattened->count + 1) * sizeof(*codes));
+         if (!codes)
+            return;
+         flattened->codes = codes;
+         uint32_t *code = vkr_flatten_shader_module_info(dev, (const void *)p);
+         if (code)
+            flattened->codes[flattened->count++] = code;
+      }
+   }
+}
+
+static void
+vkr_free_flattened_codes(struct vkr_flattened_codes *flattened)
+{
+   for (uint32_t i = 0; i < flattened->count; i++)
+      free(flattened->codes[i]);
+   free(flattened->codes);
+}
 
