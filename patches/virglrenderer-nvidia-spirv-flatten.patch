diff --git a/src/venus/vkr_spirv.c b/src/venus/vkr_spirv.c
new file mode 100644
index 0000000..924ec61
--- /dev/null
+++ b/src/venus/vkr_spirv.c
@@ -0,0 +1,76 @@
+/*
+ * Copyright 2026 The Waydroid Project
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_spirv.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef HAVE_SPIRV_TOOLS
+#include <spirv-tools/libspirv.h>
+
+static bool
+has_function_call(const uint32_t *code, size_t words)
+{
+   const uint32_t op_function_call = 57;
+   /* the header is 5 words; each instruction starts with its word count and opcode */
+   for (size_t i = 5; i < words;) {
+      uint32_t count = code[i] >> 16;
+      if ((code[i] & 0xffff) == op_function_call)
+         return true;
+      if (!count)
+         return false;
+      i += count;
+   }
+   return false;
+}
+
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size)
+{
+   const size_t words = size / 4;
+   if (words < 5 || !has_function_call(code, words) || getenv("VKR_NO_SPIRV_FLATTEN"))
+      return false;
+
+   spv_optimizer_t *optimizer = spvOptimizerCreate(SPV_ENV_UNIVERSAL_1_6);
+   spv_optimizer_options options = spvOptimizerOptionsCreate();
+   /* merge-return first, or a function returning from inside a branch isn't inlined */
+   const char *flags[] = { "--merge-return", "--inline-entry-points-exhaustive",
+                           "--eliminate-dead-functions" };
+   spv_binary binary = NULL;
+   bool ok = optimizer && options &&
+             spvOptimizerRegisterPassesFromFlagsWhilePreservingTheInterface(
+                optimizer, flags, sizeof(flags) / sizeof(flags[0])) &&
+             spvOptimizerRun(optimizer, code, words, &binary, options) == SPV_SUCCESS && binary;
+   if (options)
+      spvOptimizerOptionsDestroy(options);
+   if (optimizer)
+      spvOptimizerDestroy(optimizer);
+
+   if (ok) {
+      *out_size = binary->wordCount * 4;
+      *out = malloc(*out_size);
+      ok = *out != NULL;
+      if (ok)
+         memcpy(*out, binary->code, *out_size);
+   }
+   if (binary)
+      spvBinaryDestroy(binary);
+   return ok;
+}
+
+#else
+
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size)
+{
+   (void)code;
+   (void)size;
+   (void)out;
+   (void)out_size;
+   return false;
+}
+
+#endif
diff --git a/src/venus/vkr_spirv.h b/src/venus/vkr_spirv.h
new file mode 100644
index 0000000..8d55ef1
--- /dev/null
+++ b/src/venus/vkr_spirv.h
@@ -0,0 +1,22 @@
+/*
+ * Copyright 2026 The Waydroid Project
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_SPIRV_H
+#define VKR_SPIRV_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* NVIDIA's proprietary shader compiler crashes in vkCreateGraphicsPipelines (_nv002nvvm in
+ * libnvidia-glvkspirv, then libnvidia-gpucomp) on valid SPIR-V that calls a function returning
+ * from inside a branch from another function. Android's HDR thumbnail shader, from ANGLE, does.
+ * This inlines every call into the entry points first. Returns true and a malloc'ed copy in *out
+ * when the module had calls and was rewritten; false leaves the module as it is.
+ */
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size);
+
+#endif /* VKR_SPIRV_H */
