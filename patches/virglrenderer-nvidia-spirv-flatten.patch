diff --git a/src/venus/vkr_spirv.c b/src/venus/vkr_spirv.c
new file mode 100644
index 0000000..4a4861a
--- /dev/null
+++ b/src/venus/vkr_spirv.c
@@ -0,0 +1,219 @@
+/*
+ * Copyright 2026 The Waydroid Project
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_spirv.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef HAVE_SPIRV_TOOLS
+#include <spirv-tools/libspirv.h>
+
+#include "vkr_common.h"
+
+#define SPV_OP_ENTRY_POINT 15
+#define SPV_OP_FUNCTION 54
+#define SPV_OP_FUNCTION_END 56
+#define SPV_OP_FUNCTION_CALL 57
+
+/* Inlining grows exponentially with call depth: a 3.4 KB module whose functions each call the
+ * next twice inlines to 10 MB in a minute, on the context's dispatch thread.
+ */
+#define MAX_INLINED_WORDS (1u << 18)
+
+struct spirv_function {
+   uint32_t id;
+   uint32_t first_call;
+   uint32_t call_count;
+   uint32_t next_call;
+   /* words in the body, then in the body with every call inlined */
+   uint64_t words;
+   enum { UNVISITED, VISITING, DONE } state;
+};
+
+static uint64_t
+add_saturated(uint64_t a, uint64_t b)
+{
+   return a + b < a ? UINT64_MAX : a + b;
+}
+
+static int
+compare_function_ids(const void *a, const void *b)
+{
+   const uint32_t x = ((const struct spirv_function *)a)->id;
+   const uint32_t y = ((const struct spirv_function *)b)->id;
+   return x < y ? -1 : x > y;
+}
+
+static struct spirv_function *
+find_function(struct spirv_function *funcs, size_t count, uint32_t id)
+{
+   const struct spirv_function key = { .id = id };
+   return bsearch(&key, funcs, count, sizeof(*funcs), compare_function_ids);
+}
+
+/* Depth-first over the call graph without recursion: the guest controls its depth. */
+static bool
+inline_function(struct spirv_function *funcs,
+                const uint32_t *callees,
+                uint32_t *stack,
+                struct spirv_function *root)
+{
+   size_t depth = 0;
+   if (root->state == DONE)
+      return true;
+   root->state = VISITING;
+   stack[depth++] = root - funcs;
+   while (depth) {
+      struct spirv_function *fn = &funcs[stack[depth - 1]];
+      if (fn->next_call < fn->call_count) {
+         struct spirv_function *callee = &funcs[callees[fn->first_call + fn->next_call++]];
+         if (callee->state == VISITING)
+            return false;
+         if (callee->state == UNVISITED) {
+            callee->state = VISITING;
+            stack[depth++] = callee - funcs;
+         }
+         continue;
+      }
+      for (uint32_t i = 0; i < fn->call_count; i++)
+         fn->words = add_saturated(fn->words, funcs[callees[fn->first_call + i]].words);
+      fn->state = DONE;
+      depth--;
+   }
+   return true;
+}
+
+/* Returns the words of every entry point with its calls inlined, 0 when the module has no calls,
+ * or UINT64_MAX when it is malformed or recursive.
+ */
+static uint64_t
+inlined_words(const uint32_t *code, size_t words)
+{
+   /* the header is 5 words; each instruction starts with its word count and opcode */
+   size_t func_count = 0, call_count = 0, entry_count = 0;
+   for (size_t i = 5; i < words; i += code[i] >> 16) {
+      const uint32_t count = code[i] >> 16, op = code[i] & 0xffff;
+      if (!count || count > words - i)
+         return UINT64_MAX;
+      func_count += op == SPV_OP_FUNCTION && count >= 5;
+      call_count += op == SPV_OP_FUNCTION_CALL && count >= 4;
+      entry_count += op == SPV_OP_ENTRY_POINT && count >= 3;
+   }
+   if (!call_count)
+      return 0;
+   if (!func_count || !entry_count)
+      return UINT64_MAX;
+
+   uint64_t total = UINT64_MAX;
+   struct spirv_function *funcs = calloc(func_count, sizeof(*funcs));
+   uint32_t *callees = malloc(call_count * sizeof(*callees));
+   uint32_t *entries = malloc(entry_count * sizeof(*entries));
+   uint32_t *stack = malloc(func_count * sizeof(*stack));
+   if (!funcs || !callees || !entries || !stack)
+      goto out;
+
+   struct spirv_function *fn = NULL;
+   size_t f = 0, c = 0, e = 0;
+   for (size_t i = 5; i < words; i += code[i] >> 16) {
+      const uint32_t count = code[i] >> 16, op = code[i] & 0xffff;
+      if (op == SPV_OP_ENTRY_POINT && count >= 3) {
+         entries[e++] = code[i + 2];
+      } else if (op == SPV_OP_FUNCTION && count >= 5) {
+         fn = &funcs[f++];
+         fn->id = code[i + 2];
+         fn->first_call = c;
+      } else if (op == SPV_OP_FUNCTION_CALL && count >= 4) {
+         if (!fn)
+            goto out;
+         callees[c++] = code[i + 3];
+         fn->call_count++;
+      }
+      if (fn)
+         fn->words += count;
+      if (op == SPV_OP_FUNCTION_END)
+         fn = NULL;
+   }
+
+   qsort(funcs, func_count, sizeof(*funcs), compare_function_ids);
+   for (size_t i = 0; i < call_count; i++) {
+      const struct spirv_function *callee = find_function(funcs, func_count, callees[i]);
+      if (!callee)
+         goto out;
+      callees[i] = callee - funcs;
+   }
+
+   uint64_t sum = 0;
+   for (size_t i = 0; i < entry_count; i++) {
+      struct spirv_function *entry = find_function(funcs, func_count, entries[i]);
+      if (!entry || !inline_function(funcs, callees, stack, entry))
+         goto out;
+      sum = add_saturated(sum, entry->words);
+   }
+   total = sum;
+
+out:
+   free(stack);
+   free(entries);
+   free(callees);
+   free(funcs);
+   return total;
+}
+
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size)
+{
+   const size_t words = size / 4;
+   if (words < 5 || getenv("VKR_NO_SPIRV_FLATTEN"))
+      return false;
+   const uint64_t inlined = inlined_words(code, words);
+   if (!inlined || inlined == UINT64_MAX)
+      return false;
+   if (inlined > MAX_INLINED_WORDS) {
+      vkr_log("not inlining shader calls: %zu words would grow to over %u", words,
+              MAX_INLINED_WORDS);
+      return false;
+   }
+
+   spv_optimizer_t *optimizer = spvOptimizerCreate(SPV_ENV_UNIVERSAL_1_6);
+   spv_optimizer_options options = spvOptimizerOptionsCreate();
+   /* merge-return first, or a function returning from inside a branch isn't inlined */
+   const char *flags[] = { "--merge-return", "--inline-entry-points-exhaustive",
+                           "--eliminate-dead-functions" };
+   spv_binary binary = NULL;
+   bool ok = optimizer && options &&
+             spvOptimizerRegisterPassesFromFlagsWhilePreservingTheInterface(
+                optimizer, flags, sizeof(flags) / sizeof(flags[0])) &&
+             spvOptimizerRun(optimizer, code, words, &binary, options) == SPV_SUCCESS && binary;
+   if (options)
+      spvOptimizerOptionsDestroy(options);
+   if (optimizer)
+      spvOptimizerDestroy(optimizer);
+
+   if (ok) {
+      *out_size = binary->wordCount * 4;
+      *out = malloc(*out_size);
+      ok = *out != NULL;
+      if (ok)
+         memcpy(*out, binary->code, *out_size);
+   }
+   if (binary)
+      spvBinaryDestroy(binary);
+   return ok;
+}
+
+#else
+
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size)
+{
+   (void)code;
+   (void)size;
+   (void)out;
+   (void)out_size;
+   return false;
+}
+
+#endif
diff --git a/src/venus/vkr_spirv.h b/src/venus/vkr_spirv.h
new file mode 100644
index 0000000..8d55ef1
--- /dev/null
+++ b/src/venus/vkr_spirv.h
@@ -0,0 +1,22 @@
+/*
+ * Copyright 2026 The Waydroid Project
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_SPIRV_H
+#define VKR_SPIRV_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* NVIDIA's proprietary shader compiler crashes in vkCreateGraphicsPipelines (_nv002nvvm in
+ * libnvidia-glvkspirv, then libnvidia-gpucomp) on valid SPIR-V that calls a function returning
+ * from inside a branch from another function. Android's HDR thumbnail shader, from ANGLE, does.
+ * This inlines every call into the entry points first. Returns true and a malloc'ed copy in *out
+ * when the module had calls and was rewritten; false leaves the module as it is.
+ */
+bool
+vkr_spirv_flatten(const uint32_t *code, size_t size, uint32_t **out, size_t *out_size);
+
+#endif /* VKR_SPIRV_H */
