diff --git a/src/virtio/vulkan/vn_renderer_vtest.c b/src/virtio/vulkan/vn_renderer_vtest.c
index 5fad0b0..0ab5e19 100644
--- a/src/virtio/vulkan/vn_renderer_vtest.c
+++ b/src/virtio/vulkan/vn_renderer_vtest.c
@@ -144,6 +144,34 @@ vtest_receive_fd(struct vtest *vtest)
    return *((int *)CMSG_DATA(cmsg));
 }
 
+static void
+vtest_send_fd(struct vtest *vtest, int fd)
+{
+   char cmsg_buf[CMSG_SPACE(sizeof(int))];
+   char dummy = 0;
+   struct msghdr msg = {
+      .msg_iov =
+         &(struct iovec){
+            .iov_base = &dummy,
+            .iov_len = sizeof(dummy),
+         },
+      .msg_iovlen = 1,
+      .msg_control = cmsg_buf,
+      .msg_controllen = sizeof(cmsg_buf),
+   };
+
+   struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+   cmsg->cmsg_level = SOL_SOCKET;
+   cmsg->cmsg_type = SCM_RIGHTS;
+   cmsg->cmsg_len = CMSG_LEN(sizeof(int));
+   memcpy(CMSG_DATA(cmsg), &fd, sizeof(fd));
+
+   if (sendmsg(vtest->sock_fd, &msg, 0) < 0) {
+      vn_log(vtest->instance, "sendmsg failed: %s", strerror(errno));
+      abort();
+   }
+}
+
 static void
 vtest_write(struct vtest *vtest, const void *buf, size_t size)
 {
@@ -363,6 +391,32 @@ vtest_vcmd_resource_unref(struct vtest *vtest, uint32_t res_id)
    vtest_write(vtest, vcmd_res_unref, sizeof(vcmd_res_unref));
 }
 
+static uint32_t
+vtest_vcmd_resource_import_fd(struct vtest *vtest, uint64_t size, int fd)
+{
+   uint32_t vtest_hdr[VTEST_HDR_SIZE];
+   uint32_t vcmd_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE];
+
+   vtest_hdr[VTEST_CMD_LEN] = VCMD_RESOURCE_IMPORT_FD_SIZE;
+   vtest_hdr[VTEST_CMD_ID] = VCMD_RESOURCE_IMPORT_FD;
+
+   vcmd_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE_LO] = (uint32_t)size;
+   vcmd_import_fd[VCMD_RESOURCE_IMPORT_FD_SIZE_HI] = (uint32_t)(size >> 32);
+
+   vtest_write(vtest, vtest_hdr, sizeof(vtest_hdr));
+   vtest_write(vtest, vcmd_import_fd, sizeof(vcmd_import_fd));
+   vtest_send_fd(vtest, fd);
+
+   vtest_read(vtest, vtest_hdr, sizeof(vtest_hdr));
+   assert(vtest_hdr[VTEST_CMD_LEN] == 1);
+   assert(vtest_hdr[VTEST_CMD_ID] == VCMD_RESOURCE_IMPORT_FD);
+
+   uint32_t res_id;
+   vtest_read(vtest, &res_id, sizeof(res_id));
+
+   return res_id;
+}
