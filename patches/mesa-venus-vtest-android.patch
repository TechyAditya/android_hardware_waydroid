 vtest_vcmd_sync_create(struct vtest *vtest, uint64_t initial_val)
 {
@@ -778,6 +832,48 @@ vtest_bo_create_from_device_memory(
    return VK_SUCCESS;
 }
 
+static VkResult
+vtest_bo_create_from_dma_buf(struct vn_renderer *renderer,
+                             VkDeviceSize size,
+                             int fd,
+                             VkMemoryPropertyFlags flags,
+                             struct vn_renderer_bo **out_bo)
+{
+   struct vtest *vtest = (struct vtest *)renderer;
+
+   /* the server needs its own fd, which might also be a memfd that it wraps
+    * in a udmabuf; the client keeps mapping the original fd
+    */
+   int res_fd = os_dupfd_cloexec(fd);
+   if (res_fd < 0)
+      return VK_ERROR_TOO_MANY_OBJECTS;
+
+   mtx_lock(&vtest->sock_mutex);
+   const uint32_t res_id = vtest_vcmd_resource_import_fd(vtest, size, fd);
+   mtx_unlock(&vtest->sock_mutex);
+   if (!res_id) {
+      close(res_fd);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+
+   const bool mappable = flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+   struct vtest_bo *bo = util_sparse_array_get(&vtest->bo_array, res_id);
+   *bo = (struct vtest_bo){
+      .base = {
+         .refcount = VN_REFCOUNT_INIT(1),
+         .res_id = res_id,
+         .mmap_size = mappable ? size : 0,
+      },
+      .res_fd = res_fd,
+      .blob_flags = (mappable ? VCMD_BLOB_FLAG_MAPPABLE : 0) |
+                    VCMD_BLOB_FLAG_SHAREABLE,
+   };
+
+   *out_bo = &bo->base;
+
+   return VK_SUCCESS;
+}
