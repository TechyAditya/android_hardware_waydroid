+    private_handle_t* hnd = new private_handle_t(fd, int(reply.size),
+            private_handle_t::PRIV_FLAGS_GPU_MEMORY);
+    hnd->offset = int(reply.offset);
+    hnd->format = format;
+    hnd->width = width;
+    hnd->height = height;
+    hnd->stride = int(reply.stride / 4);
+    hnd->modifier_lo = uint32_t(reply.modifier);
+    hnd->modifier_hi = uint32_t(reply.modifier >> 32);
+    *pHandle = hnd;
+    *pStride = hnd->stride;
+    return 0;
+}
