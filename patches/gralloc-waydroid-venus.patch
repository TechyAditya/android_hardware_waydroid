+static int gralloc_alloc_gpu(int width, int height, int format,
+        buffer_handle_t* pHandle, int* pStride)
+{
+    int s = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (s < 0)
+        return -errno;
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    strcpy(addr.sun_path, kAllocSocket);
+    timeval tv = {1, 0};
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(s, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    if (connect(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
+        close(s);
+        return -ENODEV;
+    }
+
+    alloc_request req = {ALLOC_VERSION, uint32_t(width), uint32_t(height),
+            format == HAL_PIXEL_FORMAT_RGBX_8888 ? kDrmFormatXbgr8888 : kDrmFormatAbgr8888};
+    alloc_reply reply = {};
+    union {
+        char buf[CMSG_SPACE(sizeof(int))];
+        cmsghdr align;
+    } control;
+    iovec iov = {&reply, sizeof(reply)};
+    msghdr msg = {};
+    msg.msg_iov = &iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.buf;
+    msg.msg_controllen = sizeof(control.buf);
+    int fd = -1;
+    ssize_t n = -1;
+    if (send(s, &req, sizeof(req), MSG_NOSIGNAL) == sizeof(req))
+        n = recvmsg(s, &msg, MSG_WAITALL | MSG_CMSG_CLOEXEC);
+    for (cmsghdr* c = CMSG_FIRSTHDR(&msg); n > 0 && c; c = CMSG_NXTHDR(&msg, c)) {
+        if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS &&
+                c->cmsg_len == CMSG_LEN(sizeof(int)))
+            memcpy(&fd, CMSG_DATA(c), sizeof(int));
+    }
+    close(s);
+
+    const uint64_t rowBytes = uint64_t(width) * 4;
+    if (n != sizeof(reply) || reply.status != 0 || fd < 0 || reply.stride % 4 ||
+            reply.stride < rowBytes || reply.size > INT_MAX ||
+            reply.offset + uint64_t(reply.stride) * height > reply.size) {
+        if (fd >= 0)
+            close(fd);
+        ALOGW("waydroid-alloc refused %dx%d (status %d)", width, height, reply.status);
+        return -ENOMEM;
+    }
