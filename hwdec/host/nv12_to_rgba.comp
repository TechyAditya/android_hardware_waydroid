#version 450
/* Converts a decoded NV12 frame to RGBA for gpu_target.c, one pixel per
 * invocation.  The matrix takes (Y, Cb, Cr, 1) as sampled, so it carries the
 * range as well as the coefficients. */
layout(local_size_x = 16, local_size_y = 16) in;

/* both samplers take unnormalized coordinates */
layout(binding = 0) uniform sampler2D luma;
layout(binding = 1) uniform sampler2D chroma;
layout(binding = 2, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
   vec4 rows[3];
   /* where luma pixel (0, 0) samples the chroma plane, in chroma texels */
   vec2 chroma_origin;
   uvec2 size;
} p;

void main()
{
   uvec2 pos = gl_GlobalInvocationID.xy;
   if (any(greaterThanEqual(pos, p.size)))
      return;
   vec4 yuv = vec4(texelFetch(luma, ivec2(pos), 0).r,
                   textureLod(chroma, vec2(pos) * 0.5 + p.chroma_origin, 0.0).rg, 1.0);
   vec3 rgb = vec3(dot(p.rows[0], yuv), dot(p.rows[1], yuv), dot(p.rows[2], yuv));
   imageStore(dst, ivec2(pos), vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
